{
  "entities": {
    "CustomScript": {
      "title": "CustomScript",
      "description": "Agent-created or customized bilingual Shopee CS response script stored in Cloud Firestore.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID owning this custom script."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Short scenario title."
        },
        "category": {
          "type": "string",
          "enum": ["Delivery", "Delayed", "Product", "Refund", "General", "Platform"],
          "description": "Scenario category."
        },
        "whenToUse": {
          "type": "string",
          "maxLength": 600,
          "description": "Guidance on when the agent should use this script."
        },
        "policyRule": {
          "type": "string",
          "maxLength": 800,
          "description": "Summary of the enforced store policy rule."
        },
        "sampleInput": {
          "type": "string",
          "maxLength": 2500,
          "description": "Example customer inquiry or order input."
        },
        "rows": {
          "type": "array",
          "description": "Sentence-by-sentence bilingual script rows."
        },
        "paths": {
          "type": "array",
          "description": "Optional branching CX response paths for multi-stage scenarios."
        },
        "guideIds": {
          "type": "array",
          "description": "Optional attached Shopee Brazil visual guide IDs."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display ordering index for Script Library scenarios."
        },
        "isCustom": {
          "type": "boolean",
          "description": "True for agent-created or auto-learned scripts; false for seeded built-in defaults."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "ownerId",
        "title",
        "category",
        "whenToUse",
        "policyRule",
        "sampleInput",
        "rows",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreRule": {
      "title": "StoreRule",
      "description": "Bilingual Shopee Brazil store policy rule synced to Cloud Firestore across devices.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID owning this store rule."
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Policy area title."
        },
        "english": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Rule summary in English."
        },
        "portuguese": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Customer guidance in Brazilian Portuguese."
        },
        "isPrimary": {
          "type": "boolean",
          "description": "Highlights primary store policy."
        },
        "sortOrder": {
          "type": "number",
          "description": "Display order index."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "ownerId",
        "topic",
        "english",
        "portuguese",
        "isPrimary",
        "sortOrder",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated agent profile synced on Google sign-in.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID."
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "description": "Verified Google account email."
        },
        "displayName": {
          "type": "string",
          "maxLength": 160,
          "description": "Agent display name."
        },
        "scriptsSeeded": {
          "type": "boolean",
          "description": "Indicates default 16 Script Library scenarios were seeded into Cloud Firestore."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "First sign-in timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Latest sign-in timestamp."
        }
      },
      "required": [
        "ownerId",
        "email",
        "displayName",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatFlowSession": {
      "title": "ChatFlowSession",
      "description": "Multi-turn live Chat Flow conversation persisted in Cloud Firestore across PCs.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID owning this Chat Flow session."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Short label summarizing the order or scenario."
        },
        "orderInput": {
          "type": "string",
          "maxLength": 8000,
          "description": "Original order paste and opening concern."
        },
        "trackingNumber": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional tracking number."
        },
        "carrierName": {
          "type": "string",
          "maxLength": 120,
          "description": "Optional assigned carrier."
        },
        "estimatedDate": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional estimated delivery date."
        },
        "lastUpdateDate": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional last logistics update date."
        },
        "latestStatus": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional latest order/tracking status."
        },
        "issueTopic": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional issue topic."
        },
        "productSpec": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional product spec note."
        },
        "voucherTier": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional voucher tier."
        },
        "tone": {
          "type": "string",
          "enum": ["Standard Polite", "Extra Empathetic", "Firm Policy"],
          "description": "Selected reply tone."
        },
        "turns": {
          "type": "array",
          "description": "Ordered multi-turn ChatFlowTurn objects."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "ownerId",
        "title",
        "orderInput",
        "tone",
        "turns",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsageStat": {
      "title": "UsageStat",
      "description": "Tracks how often a Script Library scenario or Store Rule is accessed or applied by the Reply Generator.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated user UID owning this usage statistic."
        },
        "itemType": {
          "type": "string",
          "enum": ["script", "rule"],
          "description": "Whether the tracked item is a Script Library scenario or a Store Rule."
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document ID of the referenced script scenario or store rule."
        },
        "itemTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Human-readable scenario title or store rule topic."
        },
        "category": {
          "type": "string",
          "maxLength": 80,
          "description": "Scenario category or Primary/Policy label."
        },
        "appliedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Number of times the Reply Generator applied this item when generating a response."
        },
        "accessedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000,
          "description": "Number of times an agent accessed or loaded this item into the Reply Generator."
        },
        "lastEvent": {
          "type": "string",
          "enum": ["applied", "accessed"],
          "description": "Most recent tracking event type."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "ownerId",
        "itemType",
        "itemId",
        "itemTitle",
        "category",
        "appliedCount",
        "accessedCount",
        "lastEvent",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Authenticated user account profile."
    },
    "/users/{userId}/customScripts/{scriptId}": {
      "schema": {
        "$ref": "#/entities/CustomScript"
      },
      "description": "Per-user cloud custom CS scripts synced across all PCs."
    },
    "/users/{userId}/storeRules/{ruleId}": {
      "schema": {
        "$ref": "#/entities/StoreRule"
      },
      "description": "Per-user cloud store CS rules synced across all PCs."
    },
    "/users/{userId}/chatFlows/{flowId}": {
      "schema": {
        "$ref": "#/entities/ChatFlowSession"
      },
      "description": "Per-user cloud multi-turn Chat Flow sessions synced across all PCs."
    },
    "/users/{userId}/usageStats/{statId}": {
      "schema": {
        "$ref": "#/entities/UsageStat"
      },
      "description": "Per-user cloud usage statistics tracking how often scripts and store rules are accessed or applied."
    }
  }
}
