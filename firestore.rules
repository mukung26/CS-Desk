rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId && request.auth.token.email_verified == true;
    }

    function isValidCustomScript(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'category',
          'whenToUse',
          'policyRule',
          'sampleInput',
          'rows',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'category',
          'whenToUse',
          'policyRule',
          'sampleInput',
          'rows',
          'paths',
          'guideIds',
          'sortOrder',
          'isCustom',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.category in ['Delivery', 'Delayed', 'Product', 'Refund', 'General', 'Platform']
        && data.whenToUse is string
        && data.whenToUse.size() <= 600
        && data.policyRule is string
        && data.policyRule.size() <= 800
        && data.sampleInput is string
        && data.sampleInput.size() <= 2500
        && data.rows is list
        && data.rows.size() >= 1
        && data.rows.size() <= 30
        && data.rows[0] is map
        && (!('paths' in data) || (data.paths is list && data.paths.size() <= 10 && (data.paths.size() == 0 || data.paths[0] is map)))
        && (!('guideIds' in data) || (data.guideIds is list && data.guideIds.size() <= 6 && (data.guideIds.size() == 0 || (data.guideIds[0] is string && data.guideIds[0].size() <= 80))))
        && (!('sortOrder' in data) || (data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 1000))
        && (!('isCustom' in data) || data.isCustom is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStoreRule(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'topic',
          'english',
          'portuguese',
          'isPrimary',
          'sortOrder',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'topic',
          'english',
          'portuguese',
          'isPrimary',
          'sortOrder',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.topic is string
        && data.topic.size() >= 1
        && data.topic.size() <= 160
        && data.english is string
        && data.english.size() >= 1
        && data.english.size() <= 2000
        && data.portuguese is string
        && data.portuguese.size() >= 1
        && data.portuguese.size() <= 2000
        && data.isPrimary is bool
        && data.sortOrder is number
        && data.sortOrder >= 0
        && data.sortOrder <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'email',
          'displayName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'email',
          'displayName',
          'scriptsSeeded',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.email is string
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() <= 160
        && (!('scriptsSeeded' in data) || data.scriptsSeeded is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatFlowSession(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'title',
          'orderInput',
          'tone',
          'turns',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'title',
          'orderInput',
          'trackingNumber',
          'carrierName',
          'estimatedDate',
          'lastUpdateDate',
          'latestStatus',
          'issueTopic',
          'productSpec',
          'voucherTier',
          'tone',
          'turns',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 200
        && data.orderInput is string
        && data.orderInput.size() <= 8000
        && (!('trackingNumber' in data) || (data.trackingNumber is string && data.trackingNumber.size() <= 80))
        && (!('carrierName' in data) || (data.carrierName is string && data.carrierName.size() <= 120))
        && (!('estimatedDate' in data) || (data.estimatedDate is string && data.estimatedDate.size() <= 40))
        && (!('lastUpdateDate' in data) || (data.lastUpdateDate is string && data.lastUpdateDate.size() <= 40))
        && (!('latestStatus' in data) || (data.latestStatus is string && data.latestStatus.size() <= 200))
        && (!('issueTopic' in data) || (data.issueTopic is string && data.issueTopic.size() <= 200))
        && (!('productSpec' in data) || (data.productSpec is string && data.productSpec.size() <= 300))
        && (!('voucherTier' in data) || (data.voucherTier is string && data.voucherTier.size() <= 40))
        && data.tone in ['Standard Polite', 'Extra Empathetic', 'Firm Policy']
        && data.turns is list
        && data.turns.size() >= 1
        && data.turns.size() <= 30
        && data.turns[0] is map
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUsageStat(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'itemType',
          'itemId',
          'itemTitle',
          'category',
          'appliedCount',
          'accessedCount',
          'lastEvent',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'itemType',
          'itemId',
          'itemTitle',
          'category',
          'appliedCount',
          'accessedCount',
          'lastEvent',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.itemType in ['script', 'rule']
        && isValidId(data.itemId)
        && data.itemTitle is string
        && data.itemTitle.size() >= 1
        && data.itemTitle.size() <= 200
        && data.category is string
        && data.category.size() <= 80
        && data.appliedCount is int
        && data.appliedCount >= 0
        && data.appliedCount <= 1000000
        && data.accessedCount is int
        && data.accessedCount >= 0
        && data.accessedCount <= 1000000
        && data.lastEvent in ['applied', 'accessed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'displayName',
          'scriptsSeeded',
          'updatedAt'
        ]);

      match /customScripts/{scriptId} {
        allow get: if isOwner(userId) && isValidId(scriptId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(scriptId)
          && isValidCustomScript(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(scriptId)
          && isValidCustomScript(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'category',
            'whenToUse',
            'policyRule',
            'sampleInput',
            'rows',
            'paths',
            'guideIds',
            'sortOrder',
            'isCustom',
            'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(scriptId);
      }

      match /storeRules/{ruleId} {
        allow get: if isOwner(userId) && isValidId(ruleId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(ruleId)
          && isValidStoreRule(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(ruleId)
          && isValidStoreRule(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'topic',
            'english',
            'portuguese',
            'isPrimary',
            'sortOrder',
            'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(ruleId);
      }

      match /chatFlows/{flowId} {
        allow get: if isOwner(userId) && isValidId(flowId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(flowId)
          && isValidChatFlowSession(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(flowId)
          && isValidChatFlowSession(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'orderInput',
            'trackingNumber',
            'carrierName',
            'estimatedDate',
            'lastUpdateDate',
            'latestStatus',
            'issueTopic',
            'productSpec',
            'voucherTier',
            'tone',
            'turns',
            'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(flowId);
      }

      match /usageStats/{statId} {
        allow get: if isOwner(userId) && isValidId(statId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(statId)
          && isValidUsageStat(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidId(statId)
          && isValidUsageStat(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().itemType == existing().itemType
          && incoming().itemId == existing().itemId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'itemTitle',
            'category',
            'appliedCount',
            'accessedCount',
            'lastEvent',
            'updatedAt'
          ]);
        allow delete: if isOwner(userId) && isValidId(statId);
      }
    }
  }
}
